{
  "schema_version": "2.0",
  "template_name": "FIAR-Audit-Template",
  "description": "Estrutura operacional de referência para ciclos do FIAR-Saúde.",
  "required_root_files": [
    "README.md"
  ],
  "required_root_directories": {
    "entrada": {
      "required_files": [
        "formulario_entrada.md"
      ]
    },
    "comunicacoes": {
      "required_files": [
        "README.md"
      ]
    },
    "ciclos": {
      "required_directories": {
        "C01": {
          "required_files": [
            "identificacao.md",
            "avaliacao.md"
          ]
        }
      }
    },
    "relatorios": {
      "required_files": [
        "RCG-001.md"
      ]
    },
    "decisoes": {
      "required_files": [
        "DCG-001.md"
      ]
    },
    "artefatos": {
      "required_files": [
        "README.md"
      ],
      "required_directories": {
        "data_cards": {
          "required_files": []
        },
        "model_cards": {
          "required_files": []
        },
        "fairness_reports": {
          "required_files": [
            "fairness_report_inicial.md"
          ],
          "accepted_legacy_files": [
            "fairness_report_v1.md"
          ]
        },
        "explainability_reports": {
          "required_files": [
            "explainability_report_inicial.md"
          ],
          "accepted_legacy_files": [
            "explainability_report_v1.md"
          ]
        },
        "decision_records": {
          "required_files": [
            "DTE-001-template.md"
          ]
        },
        "consolidated_iar_report": {
          "required_files": [
            "consolidated_report_v1.md"
          ],
          "accepted_legacy_files": [
            "consolidated_report_v1.md"
          ]
        },
        "compliance": {
          "required_files": [
            "README.md"
          ],
          "required_directories": {
            "ripd": {
              "required_files": [
                "README.md"
              ],
              "optional_files": [
                "RIPD.docx",
                "ripd.docx"
              ]
            }
          }
        },
        "operational_artifacts": {
          "required_files": [
            "README.md"
          ],
          "required_directories": {
            "monitoring": {
              "required_files": [
                "README.md",
                "monitoring_report_template.md"
              ]
            },
            "incidents": {
              "required_files": [
                "README.md",
                "incident_record_template.md"
              ]
            },
            "version_history": {
              "required_files": [
                "README.md",
                "version_change_record_template.md"
              ]
            },
            "periodic_review": {
              "required_files": [
                "README.md",
                "periodic_review_template.md"
              ]
            }
          }
        }
      }
    },
    "documentacao_metodologica": {
      "required_files": [
        "guia_fluxo.md",
        "guia_requisitos_avaliacao.md",
        "prompts_avaliacao.md",
        "apoio_roteiro_entrevista.md"
      ]
    },
    "fiar_sync": {
      "required_files": [
        "fiar_structure.json",
        "sync_structure.sh",
        "validate_structure.py"
      ]
    },
    "pdf": {
      "required_files": [
        "package.json"
      ]
    }
  },
  "optional_root_directories": [
    ".github",
    "docs",
    "scripts"
  ],
  "legacy_paths": {
    "directories": {
      "artefatos_projeto": "artefatos",
      "artefatos_operacionais": "artefatos/operational_artifacts"
    },
    "files": {}
  },
  "validation": {
    "allow_legacy_paths_during_transition": true,
    "fail_on_missing_required_path": true,
    "fail_on_empty_required_template": true,
    "warn_on_legacy_path": true,
    "warn_on_unexpected_sensitive_files": true,
    "ignored_paths": [
      ".git",
      "node_modules",
      "pdf/node_modules",
      "pdf/output",
      "__pycache__",
      ".DS_Store"
    ],
    "sensitive_file_patterns": [
      "*.pem",
      "*.key",
      "*.p12",
      "*.pfx",
      "*.env",
      ".env.*",
      "*credentials*",
      "*secret*",
      "*token*"
    ]
  }
}
